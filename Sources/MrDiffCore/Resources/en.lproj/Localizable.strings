/* 人が読む出力。機械向け（--json）はここを通さない。 */

"text.identical"       = "No differences";
"text.summary"         = "%d changed, %d added, %d removed";
"images.identical"     = "Images are identical";
"images.differ"        = "Images differ — %d of %d pixels (%@%%)";
"images.differ.tiny"   = "Images differ — %d of %d pixels";
"images.first"         = "First difference at (%d, %d)";
"images.gap"           = "largest per-channel gap: %d — --tolerance=%d would call these the same";
"images.tone.brighter" = "B is brighter overall by about %d per channel (R G B: %@)";
"images.tone.darker"   = "B is darker overall by about %d per channel (R G B: %@)";

/* 緩めて比べたときは、そう言う。「同じ」とだけ言うと嘘になる。 */
"note.compared_with"   = "compared with %@";
"note.tolerance"       = "±%d per channel";
"note.ignore_alpha"    = "alpha ignored";
"note.separator"       = ", ";
"images.size_mismatch" = "Images differ in size — %dx%d vs %dx%d";

"error.cannot_open"    = "cannot open %@";
"error.not_an_image"   = "not an image: %@";
"error.cannot_decode"  = "cannot decode %@";
"error.usage"          = "usage: mrdiff [--version] [--exit-code] [--json] [--tolerance=N] [--ignore-alpha] [--color=auto|always|never] [--no-pager] [--clipboard] [--lang=en|ja] <a> <b>\n       a and b may be files or http(s) URLs; with --clipboard, give one\n       mrdiff --help lists every option";
"error.bad_tolerance"  = "--tolerance needs a number 0 or greater";
"error.bad_color"      = "--color takes always, never or auto";
"error.mixed_kinds"    = "cannot compare text with a non-text file";
"error.image_only_flag" = "--tolerance and --ignore-alpha apply to images, not text";

/* バイナリ。人が読む出力だけ。 */
"binary.identical"     = "No differences (binary)";
"binary.differ"        = "Binary files differ — %d regions, first at %@";
"binary.differ.one"    = "Binary files differ — 1 region at %@";
"binary.bytes"         = "%d of %d bytes differ";
"binary.size"          = "Sizes differ — %d vs %d bytes (%d extra)";
"binary.common_only"   = "compared the first %d bytes they have in common";
"binary.common_same"   = "the first %d bytes they have in common are identical";

/* 入れ物（ファイル・URL・クリップボード）。 */
"input.clipboard"      = "clipboard";
"error.http_status"    = "HTTP %d from %@";
"error.fetch_failed"   = "cannot fetch %@: %@";
"error.empty_clipboard" = "the clipboard is empty (or holds nothing that can be compared)";
"error.no_clipboard"   = "the clipboard is not available on this system";
"error.clipboard_needs_one" = "--clipboard takes one file or URL to compare against";
"note.fetched"         = "fetched %@ and %@";
"note.redirected"      = "%@ redirected to %@";

/* サイト diff（git 管理下の公開フォルダ × 公開中のサイト）。 */
"site.changed"         = "changed   %@";
"site.missing"         = "not on site   %@";
"site.error"           = "could not check   %@";
"site.in_sync"         = "In sync — %d files match the site";
"site.summary"         = "%d changed, %d not deployed, %d could not be checked";
"site.cannot_find_extras" = "note: files on the site that are not in git cannot be found this way (HTTP has no directory listing)";
"error.site_usage"     = "usage: mrdiff --site <https://base> <dir>  (dir must be inside a git work tree)";
"error.site_empty"     = "no git-tracked files under %@";
"error.not_git"        = "%@ is not inside a git repository";
"error.git_failed"     = "git failed: %@";
"error.git_missing"    = "git is not installed";
"error.ssh_failed"     = "cannot fetch %@ over ssh: %@";

/* SSH ディレクトリ diff（両方向）。 */
"tree.changed"         = "changed   %@";
"tree.only_local"      = "only local (not deployed)   %@";
"tree.only_remote"     = "only on remote (left over?)   %@";
"tree.in_sync"         = "In sync — %d files match";
"tree.summary"         = "%d changed, %d only local, %d only on remote";
"error.ssh_usage"      = "usage: mrdiff --ssh <local-dir> <host:/path>";
"error.ssh_list_failed" = "cannot list the remote directory: %@";
"error.not_a_dir"      = "%@ is not a directory";

/* PDF。ページごとに描いて画素で比べる。場所は紙の単位（mm）。 */
"pdf.identical"        = "No differences (%d pages)";
"pdf.summary"          = "PDFs differ — %d of %d pages";
"pdf.page_count"       = "Page count differs — %d vs %d";
"pdf.common_same"      = "the %d pages they have in common are identical";
"pdf.page.differ"      = "p.%d  %d regions";
"pdf.page.differ.one"  = "p.%d  1 region";
"pdf.page.size_mismatch" = "p.%d  page size differs — %@ × %@ mm vs %@ × %@ mm";
"pdf.region"           = "top %@ mm, left %@ mm, %@ × %@ mm";
"pdf.only"             = "p.%d–%d  only in %@";
"pdf.only.one"         = "p.%d  only in %@";
"pdf.rendered"         = "pages rendered at %d dpi; positions are on the page, in mm";
"error.not_a_pdf"      = "not a PDF (or it has no pages)";
"error.pdf_render"     = "cannot render page %d";
"error.pdf_alpha_flag" = "--ignore-alpha does not apply to PDFs (pages are rendered on white)";
"error.mixed_pdf"      = "cannot compare a PDF with a non-PDF file";

/* --help。スイッチごとに 1 行。 */
"help.usage"           = "usage: mrdiff [options] <a> <b>\n       mrdiff [options] <dirA> <dirB>\n       mrdiff --clipboard <b>\n       mrdiff --site <https://base> <dir>\n       mrdiff --ssh <dir> <host:path>";
"help.inputs"          = "Compares two things and says whether they differ, and where. a and b may be files or\nhttp(s) URLs; what they are is decided from the content, not the name — text, image,\nPDF, archive (zip, docx, xlsx, pptx, epub…), font or binary. Two folders: which files differ, or exist\non one side only. Nothing is rendered.";
"help.exit_code"       = "exit 1 when they differ (default: 0 either way; 2 when it could not run)";
"help.json"            = "one line of JSON, never translated";
"help.tolerance"       = "images/PDFs: treat per-channel gaps up to N as the same (default 0 = exact)";
"help.ignore_alpha"    = "images: do not compare the alpha channel";
"help.color"           = "color the text diff (default auto: only on a terminal; NO_COLOR is honoured)";
"help.no_pager"        = "do not page a long text diff";
"help.clipboard"       = "compare the clipboard against one file or URL";
"help.site"            = "check a deployed site against the git-tracked folder it was built from";
"help.ssh"             = "compare a local folder with a folder on a server, both ways";
"help.lang"            = "language of this output (same as MRDIFF_LANG; default en, never taken from LANG)";
"help.version"         = "print the version";
"help.help"            = "this text";
"help.exit"            = "exit codes: 0 it ran, 1 they differ and --exit-code was given, 2 it could not run";
"help.other_lang.ja"   = "Japanese: mrdiff --help --lang=ja";
"help.other_lang.en"   = "English: mrdiff --help --lang=en";

/* 手元のフォルダ同士。 */
"dir.changed"          = "changed   %@";
"dir.only_a"           = "only in A   %@";
"dir.only_b"           = "only in B   %@";
"dir.in_sync"          = "No differences — %d files match";
"dir.summary"          = "%d changed, %d only in A, %d only in B";
"error.mixed_dir"      = "cannot compare a folder with a file";
"error.dir_flag"       = "--tolerance and --ignore-alpha apply to images and PDFs, not folders (compare the two files directly)";

/* zip の中身、Word の本文、フォント。 */
"archive.in_sync"      = "No differences — %d files inside match";
"archive.summary"      = "%d changed, %d only in A, %d only in B (inside the archive)";
"error.mixed_zip"      = "cannot compare an archive with a non-archive file";
"error.bad_zip"        = "cannot read the archive (damaged, or zip64)";
"error.pixel_flag"     = "--tolerance and --ignore-alpha apply to images and PDFs only";
"docx.identical"       = "No differences in the text (%d paragraphs)";
"docx.summary"         = "paragraphs: %d changed, %d added, %d removed";
"docx.others"          = "%d other parts differ (formatting, media, properties) — the text above is what changed in the body";
"font.identical"       = "No differences — %d glyphs render the same";
"font.same_glyphs"     = "the %d glyphs both fonts have render the same";
"font.differ"          = "Fonts differ — %d of %d glyphs render differently";
"font.first"           = "first: %@";
"font.only_a"          = "only in A: %d characters (first %@)";
"font.only_b"          = "only in B: %d characters (first %@)";
"font.name"            = "name: %@ → %@";
"font.version"         = "version: %@ → %@";
"font.rendered"        = "each glyph rendered in a %d px cell and compared pixel by pixel";
"error.not_a_font"     = "not a font CoreText can open (OTF, TTF, TTC)";
"error.mixed_font"     = "cannot compare a font with a non-font file";

/* PDF の文字。 */
"help.text"            = "PDFs: compare the text (one line per line of text, [p.N] marks pages) instead of the rendering";
"pdf.text.identical"   = "No differences in the text (%d lines)";
"pdf.text.summary"     = "text: %d lines changed, %d added, %d removed";
"pdf.text.same"        = "the text is identical — only the rendering differs (fonts, images, layout)";
"pdf.text.hint"        = "the text differs in %d lines — mrdiff --text shows them";
"pdf.text.none"        = "no text to compare (scanned pages?)";
"error.pdf_no_text"    = "no text in one of the PDFs (scanned pages?) — compare without --text";
"error.text_flag"      = "--text applies to PDFs";

/* ずらして比べる（画像）。 */
"help.offset"          = "images: place the right image at (dx,dy) on the left one and compare the overlap only";
"note.offset"          = "right shifted by (%d, %d) — the %d overlapping pixels only";
"note.offset.plain"    = "right shifted by (%d, %d)";
"error.bad_offset"     = "--offset takes two integers: --offset=dx,dy";
"error.offset_flag"    = "--offset applies to images";
